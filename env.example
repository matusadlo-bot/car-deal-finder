# Python app settings
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) CarDealFinder/0.4
REQUEST_DELAY_SECONDS=1.1

# Official mobile.de Search API credentials (NOT your normal mobile.de website login)
MOBILE_DE_API_USERNAME=
MOBILE_DE_API_PASSWORD=

# Optional AI second-pass analysis
OPENAI_API_KEY=
OPENAI_MODEL=
AI_ANALYSIS_MODE=top
AI_MAX_PER_SCAN=100

# Optional FX fallbacks. Normally ECB rates are downloaded automatically.
CZK_PER_EUR=25.0
PLN_PER_EUR=4.30
HUF_PER_EUR=390.0

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
